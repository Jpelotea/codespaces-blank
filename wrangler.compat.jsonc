{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-copilot-cloudflare-compat",
  "main": "worker/runtime-compatibility.mjs",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/compat/*"]
  },
  "vars": {
    "PHASE_0_5_RUNTIME_MARKER": "worker-runtime-marker",
    "GEMINI_API_KEY": "phase-0.5-invalid-nonsecret-key"
  }
}
