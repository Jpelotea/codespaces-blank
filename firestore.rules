rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Persistent authenticated users can strictly read and write their own documents and subcollections.
    // Anonymous Firebase sessions are preview-only and must not access private workspace data.
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == userId;
      }
    }
  }
}
